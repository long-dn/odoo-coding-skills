{
  "name": "odoo-coding-skills",
  "version": "0.2.0",
  "description": "Version-aware AI coding rules packs (Odoo 19, etc.) for Claude, Cursor, GitHub Copilot, Cline, Windsurf, Aider, Continue.dev. Run via npx for interactive install.",
  "bin": {
    "odoo-coding-skills": "./installer/index.js"
  },
  "files": [
    "dist",
    "installer",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
